# Copy to .env.local for local dev, or set in the Vercel dashboard for production.
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Durable lead storage + suppression list (lib/store.js). Create a Redis
# database at https://vercel.com/marketplace (Upstash) or https://upstash.com
# directly, and copy its REST URL/token here. The KV_REST_API_* names (what
# Vercel's own integration sets) also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs/verifies unsubscribe links (lib/sign.js, api/unsubscribe.js). Any long
# random string. Changing it invalidates every unsubscribe link already sent.
UNSUBSCRIBE_SECRET=

# Bearer token required to call /api/export-leads. Any long random string.
ADMIN_EXPORT_TOKEN=
